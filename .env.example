# Clave del panel de administración (/admin). CÁMBIALA en producción.
# Sin esta variable, en dev se usa "wedring-admin-dev".
WEDRING_ADMIN_KEY=pon-aqui-una-clave-larga-y-secreta

# Ruta del archivo de datos (opcional). Por defecto: ./data/wedring-db.json
# ⚠️ El almacén en archivo es para dev/self-hosted. En serverless (Vercel) el
# filesystem es efímero: antes de lanzar, cambia lib/server/db.ts a una DB real.
# WEDRING_DB_PATH=/var/data/wedring-db.json
